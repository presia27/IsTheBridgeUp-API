  "author": "Preston Sia (psia97)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "description": "See when Seattle's draw bridges open for boat traffic.",
  "dependencies": {
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.1",
    "nocache": "^4.0.0",
    "node-cache": "^5.1.2",
    "pg": "^8.14.1"
  },
